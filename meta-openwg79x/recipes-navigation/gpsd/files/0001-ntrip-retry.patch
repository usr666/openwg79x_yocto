gpsd: retry NTRIP sources and follow NTRIP socket changes

Command line ntrip:// sources are checked every 120 s and re-added when not
delivering data. Outage start and end are logged at ERROR level.

The main loop did not move select() to the new socket NTRIP opens after the
source table probe, so data was never read unless the new socket got the
same fd number as the probe socket.

Upstream-Status: Inappropriate [local]

--- a/gpsd/gpsd.c	2026-11-10 18:53:40.088032517 +0000
+++ b/gpsd/gpsd.c	2026-11-10 19:16:01.345516711 +0000
@@ -849,6 +849,55 @@
     return ret;
 }
 
+#define NTRIP_MAX 4
+#define NTRIP_RETRY_S 120
+static char ntrip_urls[NTRIP_MAX][GPS_PATH_MAX];
+static int ntrip_count;
+
+// re-add command line NTRIP sources that have stopped delivering data
+static void ntrip_retry(void)
+{
+    static time_t last_check;
+    static unsigned long last_count[NTRIP_MAX];
+    static bool down[NTRIP_MAX];
+    struct timespec ts;
+    time_t now;
+    int i;
+
+    (void)clock_gettime(CLOCK_MONOTONIC, &ts);
+    now = ts.tv_sec;
+    if (0 == last_check) {
+        last_check = now;
+    }
+    if (NTRIP_RETRY_S > now - last_check) {
+        return;
+    }
+    last_check = now;
+    for (i = 0; i < ntrip_count; i++) {
+        struct gps_device_t *devp = find_device(ntrip_urls[i]);
+        bool works = NULL != devp && 0 < devp->gpsdata.gps_fd && NTRIP_CONN_ESTABLISHED == devp->ntrip.conn_state && devp->lexer.char_counter != last_count[i];
+
+        if (works) {
+            last_count[i] = devp->lexer.char_counter;
+            if (down[i]) {
+                GPSD_LOG(LOG_ERROR, &context.errout, "NTRIP: %s working again\n", ntrip_urls[i]);
+                down[i] = false;
+            }
+            continue;
+        }
+        if (!down[i]) {
+            GPSD_LOG(LOG_ERROR, &context.errout, "NTRIP: %s not working, retrying every %d s\n", ntrip_urls[i], NTRIP_RETRY_S);
+            down[i] = true;
+        }
+        if (NULL != devp) {
+            deactivate_device(devp);
+            free_device(devp);
+        }
+        last_count[i] = 0;
+        (void)gpsd_add_device(ntrip_urls[i], true);
+    }
+}
+
